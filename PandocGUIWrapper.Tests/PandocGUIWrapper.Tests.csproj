<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <IsPackable>false</IsPackable>
    <RootNamespace>PandocGUIWrapper.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\PandocGUIWrapper\Models\*.cs" Link="Linked\Models\%(Filename)%(Extension)" />
    <Compile Include="..\PandocGUIWrapper\ViewModels\*.cs" Link="Linked\ViewModels\%(Filename)%(Extension)" />
    <Compile Include="..\PandocGUIWrapper\Services\*.cs" Exclude="..\PandocGUIWrapper\Services\DialogService.cs" Link="Linked\Services\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="MSTest.TestAdapter" Version="4.5.1" />
    <PackageReference Include="MSTest.TestFramework" Version="4.5.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

</Project>
