<UserControl
      x:Class="PandocGUIWrapper.Views.ConvertView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:vm="clr-namespace:PandocGUIWrapper.ViewModels"
      d:DataContext="{d:DesignInstance Type=vm:ConvertViewModel}"
      d:DesignHeight="260"
      d:DesignWidth="600"
      mc:Ignorable="d">
      <UserControl.Resources>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
      </UserControl.Resources>

      <!--  The Convert tab: input file, output name, format, reference document, folder, and the Convert button.  -->
      <Grid Margin="12">
            <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Label
                  Grid.Row="0"
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Content="_Input file:"
                  Target="{Binding ElementName=InputPathBox}" />
            <TextBox
                  x:Name="InputPathBox"
                  Grid.Row="0"
                  Grid.Column="1"
                  Margin="8,4"
                  Padding="2"
                  VerticalContentAlignment="Center"
                  IsReadOnly="True"
                  Text="{Binding InputPath, Mode=OneWay}" />
            <Button
                  Grid.Row="0"
                  Grid.Column="2"
                  Width="88"
                  Margin="0,4"
                  Command="{Binding BrowseInputCommand}"
                  Content="Browse…" />

            <Label
                  Grid.Row="1"
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Content="Output _name:"
                  Target="{Binding ElementName=OutputNameBox}" />
            <TextBox
                  x:Name="OutputNameBox"
                  Grid.Row="1"
                  Grid.Column="1"
                  Grid.ColumnSpan="2"
                  Margin="8,4,0,4"
                  Padding="2"
                  VerticalContentAlignment="Center"
                  IsEnabled="{Binding IsIdle}"
                  Text="{Binding OutputName, UpdateSourceTrigger=PropertyChanged}" />

            <Label
                  Grid.Row="2"
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Content="Output _format:"
                  Target="{Binding ElementName=OutputFormatCombo}" />
            <ComboBox
                  x:Name="OutputFormatCombo"
                  Grid.Row="2"
                  Grid.Column="1"
                  Grid.ColumnSpan="2"
                  Margin="8,4,0,4"
                  DisplayMemberPath="DisplayName"
                  IsEnabled="{Binding IsIdle}"
                  ItemsSource="{Binding OutputFormats}"
                  SelectedItem="{Binding SelectedOutputFormat}" />

            <!--  Shown only for formats that use a reference document (docx, odt, pptx). Set it on the Reference documents tab.  -->
            <Label
                  Grid.Row="3"
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Content="Reference doc:"
                  Visibility="{Binding IsReferenceDocumentSupported, Converter={StaticResource BoolToVisibility}}" />
            <TextBox
                  x:Name="ReferenceDocumentBox"
                  Grid.Row="3"
                  Grid.Column="1"
                  Grid.ColumnSpan="2"
                  Margin="8,4,0,4"
                  Padding="2"
                  VerticalContentAlignment="Center"
                  Background="{x:Static SystemColors.ControlBrush}"
                  IsReadOnly="True"
                  Text="{Binding ReferenceDocumentText, Mode=OneWay}"
                  ToolTip="{Binding ReferenceDocumentPath}"
                  Visibility="{Binding IsReferenceDocumentSupported, Converter={StaticResource BoolToVisibility}}" />

            <Label
                  Grid.Row="4"
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Content="Output f_older:"
                  Target="{Binding ElementName=OutputFolderBox}" />
            <TextBox
                  x:Name="OutputFolderBox"
                  Grid.Row="4"
                  Grid.Column="1"
                  Margin="8,4"
                  Padding="2"
                  VerticalContentAlignment="Center"
                  IsEnabled="{Binding IsIdle}"
                  Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}" />
            <Button
                  Grid.Row="4"
                  Grid.Column="2"
                  Width="88"
                  Margin="0,4"
                  Command="{Binding BrowseOutputFolderCommand}"
                  Content="Browse…" />

            <Button
                  Grid.Row="5"
                  Grid.Column="2"
                  Width="88"
                  Height="28"
                  Margin="0,12,0,0"
                  Command="{Binding ConvertCommand}"
                  Content="_Convert"
                  IsDefault="True" />

            <TextBlock
                  Grid.Row="6"
                  Grid.Column="0"
                  Grid.ColumnSpan="3"
                  Margin="0,12,0,0"
                  Foreground="Gray"
                  Text="{Binding Status}"
                  TextWrapping="Wrap" />
      </Grid>
</UserControl>
